{
    "name" : "Simply Blocks (Revamped Chrome)",
    "description" : "An asthetic productivity based extension with a block environment.",
    "manifest_version" : 3,
    "version" : "1.0.0",
    "action":{
        "default_icon": {
            "16": "sbrc16.png",
            "32": "sbrc32.png",
            "48": "sbrc48.png",
            "128": "sbrc128.png"
        }
    },
    "icons": {
        "16": "sbrc16.png",
        "32":"sbrc32.png",
        "48":"sbrc48.png",
        "128":"sbrc128.png"
    },
     "oauth2": {
    "client_id": "627446987297-j70am52j8dclp4puble2i2cdjos5efeh.apps.googleusercontent.com",
    "scopes": [
      "openid",
      "email",
      "profile",
      "https://www.googleapis.com/auth/drive.file",
      "https://www.googleapis.com/auth/drive",
      "https://www.googleapis.com/auth/documents",
      "https://www.googleapis.com/auth/spreadsheets",
      "https://www.googleapis.com/auth/presentations"

    ]
  },
    "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["styles.css"],
      "js": ["websiteStyles.js", "aiFileBridge.js"]
    }
  ],
    "permissions":[
        "tabs",
        "tabGroups",
        "sidePanel",
        "identity",
        "storage",
        "favicon",
        "unlimitedStorage",
        "downloads",
        "scripting"
    ],
    "host_permissions": [
        "https://openidconnect.googleapis.com/*",
        "https://oauth2.googleapis.com/*",
        "https://www.googleapis.com/*",
        "https://*/*",
        "http://*/*"
    ],
    "chrome_url_overrides":{
        "newtab" : "newTab.html"
    },
    "side_panel":{
        "default_path" : "sidePanel.html"
    },
    "background": {
        "service_worker": "background.js",
        "type" : "module"
    }
}
